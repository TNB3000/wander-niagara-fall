{# --- The audience pick: three crates, three kinds of fall --- #}
<section class="section" id="pick" data-module="home">
  <div class="wrap">
    <div class="section__head stamp">
      <h2><span class="rule-l"></span>Pick your crate</h2>
      <p class="muted">Every plan below is packed for a different crew. Open yours.</p>
    </div>
    <div class="itin-grid">
      <article class="crate crate--concord stamp">
        <span class="lot crate__lot">Lot №1</span>
        <div class="crate__art"><svg aria-hidden="true"><use href="#i-grapes"></use></svg></div>
        <div class="crate__body">
          <h3 class="crate__title">Couples &amp; friends</h3>
          <p class="crate__grade">Wine · long dinners · live nights</p>
          <p class="crate__blurb">Escarpment wineries, chef's tables, boutique stays and evenings out.</p>
          <div class="crate__cta">
            <a class="btn" href="/couples/" data-module="home" data-card-label="Couples & friends">Open the couples' crate</a>
          </div>
        </div>
      </article>
      <article class="crate crate--leaf stamp">
        <span class="lot crate__lot">Lot №2</span>
        <div class="crate__art"><svg aria-hidden="true"><use href="#i-ferris"></use></svg></div>
        <div class="crate__body">
          <h3 class="crate__title">Families</h3>
          <p class="crate__grade">Colours · farms · big days out</p>
          <p class="crate__blurb">Easy trails, pumpkin patches, corn mazes and family attractions.</p>
          <div class="crate__cta">
            <a class="btn" href="/families/" data-module="home" data-card-label="Families">Open the family crate</a>
          </div>
        </div>
      </article>
      <article class="crate crate--persimmon stamp">
        <span class="lot crate__lot">Lot №3</span>
        <div class="crate__art"><svg aria-hidden="true"><use href="#i-star"></use></svg></div>
        <div class="crate__body">
          <h3 class="crate__title">What's on</h3>
          <p class="crate__grade">Festivals · markets · music</p>
          <p class="crate__blurb">The season's dated events — festivals, studio tours and lightings.</p>
          <div class="crate__cta">
            <a class="btn" href="/events/" data-module="home" data-card-label="What's on">See the season's dates</a>
          </div>
        </div>
      </article>
    </div>
    <p class="center mt-2"><a class="section__link" href="/stories/" data-module="home">Or read the fall stories first &rarr;</a></p>
  </div>
</section>

