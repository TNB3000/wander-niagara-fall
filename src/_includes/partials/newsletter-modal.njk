{# EXIT-INTENT MODAL — shown by app.js (capped once / 30 days, never before 30s,
   never on load). Same Mailchimp form as the inline fallback. #}
<div class="modal" id="nl-modal" role="dialog" aria-modal="true" aria-labelledby="nl-modal-title" aria-hidden="true">
  <div class="modal__backdrop" data-close></div>
  <div class="modal__panel">
    <button class="modal__close" type="button" data-close aria-label="Close">&times;</button>
    <h2 id="nl-modal-title">{{ nlModalTitle or "Get our fall guide in your inbox" }}</h2>
    <p>{{ nlModalBlurb or "One email, packed with fall itineraries and events. [PLACEHOLDER copy]" }}</p>
    <form class="nl-form" data-nl-loc="modal"
          {% if embeds.mailchimp.actionUrl %}action="{{ embeds.mailchimp.actionUrl }}"{% endif %}
          method="post" target="_blank" novalidate style="justify-content:center">
      <label class="visually-hidden" for="nl-email-modal">Email address</label>
      <input id="nl-email-modal" type="email" name="EMAIL" placeholder="you@email.com" required autocomplete="email">
      {% if embeds.mailchimp.honeypot %}
      <div aria-hidden="true" style="position:absolute;left:-5000px">
        <input type="text" name="{{ embeds.mailchimp.honeypot }}" tabindex="-1" value="">
      </div>
      {% endif %}
      <button class="btn" type="submit">Send it</button>
    </form>
    <p class="nl-fineprint" style="color:var(--muted)">No spam. Unsubscribe anytime. [PLACEHOLDER]</p>
  </div>
</div>
