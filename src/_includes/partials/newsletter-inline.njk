{# Newsletter — simple inline form, per the client mockup. #}
<section class="section" id="newsletter">
  <div class="wrap">
    <div class="nl">
      <h2>{{ nlTitle or "Get our fall guide in your inbox" }}</h2>
      {# Builder note: form activates once embeds.mailchimp.actionUrl is pasted in. #}
      <form data-nl-loc="inline"
            {% if embeds.mailchimp.actionUrl %}action="{{ embeds.mailchimp.actionUrl }}"{% endif %}
            method="post" target="_blank" novalidate>
        <label class="visually-hidden" for="nl-email">Email address</label>
        <input id="nl-email" type="email" name="EMAIL" placeholder="you@email.com" required autocomplete="email">
        {% if embeds.mailchimp.honeypot %}
        <div aria-hidden="true" style="position:absolute;left:-5000px">
          <input type="text" name="{{ embeds.mailchimp.honeypot }}" tabindex="-1" value="">
        </div>
        {% endif %}
        <button class="btn" type="submit">Send me the guide</button>
      </form>
      {% if not embeds.mailchimp.actionUrl %}
      <p class="fine">[PLACEHOLDER — signup goes live at launch] No spam. Unsubscribe anytime.</p>
      {% else %}
      <p class="fine">No spam. Unsubscribe anytime.</p>
      {% endif %}
    </div>
  </div>
</section>
