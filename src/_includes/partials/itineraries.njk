{# Itineraries — simple warm-paper text cards, per the client mockup. Each opens
   a Whereabouts itinerary (outbound). Will be replaced by the itinerary widget
   once Whereabouts backend content is live. #}
{% set items = itineraries[variant] %}
{% if items %}
<section class="section" id="itineraries" data-module="itinerary">
  <div class="wrap">
    <div class="section__head"><h2>{{ itinerariesTitle or "Fall itineraries, mapped out" }}</h2></div>
    <div class="grid-3">
      {% for it in items %}
      <a class="itin" href="{{ it.url }}" data-module="itinerary" data-card-label="{{ it.title }}">
        <p class="itin__meta">{{ it.duration }} · {{ it.stops }} stops</p>
        <h3>{{ it.title }}</h3>
        <p>{{ it.blurb }}</p>
        <span class="tlink"><span>{{ it.cta }}</span></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
