{# MAP + HOW TO GET HERE — lazy embed slot for the interactive map (Whereabouts)
   + drive-times as a shipping manifest. Keep to one screen. #}
<section class="section section--stock2" id="map">
  <div class="wrap">
    <div class="section__head stamp">
      <h2><span class="rule-l"></span>{{ mapTitle or "The map & getting here" }}</h2>
    </div>
    <div class="map-grid">
      {# --- Map embed slot (lazy). Real embed pasted into embeds.mapEmbed. --- #}
      <div class="embed-wrap stamp" data-embed="map">
        {# Builder note: paste the Whereabouts map into embeds.whereabouts.mapEmbed — loads lazily. #}
        <div class="embed-slot embed-map">
          <div>
            <strong>The interactive map</strong>
            [PLACEHOLDER — the regional map ships with launch]
          </div>
        </div>
        {% if embeds.whereabouts.mapEmbed %}
        <template>{{ embeds.whereabouts.mapEmbed | safe }}</template>
        {% endif %}
      </div>

      {# --- Getting here: the shipping manifest --- #}
      <div class="getting-here plate stamp">
        <h3 style="margin-top:0">Getting here</h3>
        <ul>
          {% for o in site.gettingHere.origins %}
          <li>
            <span class="from">{{ o.from }}</span>
            <span><span class="time">{{ o.time }}</span> <span class="note">{{ o.note }}</span></span>
          </li>
          {% endfor %}
        </ul>
        <p class="transit">{{ site.gettingHere.transit }}</p>
      </div>
    </div>
  </div>
</section>
