{# Yellow sticky header — brand, on-page nav, one CTA. Per the client mockup. #}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ headerHomeHref or '/' }}">Wander Niagara</a>
    {% if anchors %}
    <nav class="nav" aria-label="On this page">
      {% for a in anchors %}<a href="{{ a.href }}">{{ a.label }}</a>{% endfor %}
    </nav>
    {% endif %}
    <a class="btn btn--sm header-cta" href="{{ headerCtaHref or '#itineraries' }}" data-module="header">{{ headerCtaLabel or "See itineraries" }}</a>
  </div>
</header>
<span id="top"></span>
