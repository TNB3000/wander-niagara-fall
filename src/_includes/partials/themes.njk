{# THEMED BUSINESS MODULES — visitpa-style horizontal scrollers (CSS scroll-snap).
   4 themes per page, 3–6 cards each. Every card is an OUTBOUND link.
   Fully data-driven from _data/businesses.json — add businesses with no template edits. #}
{% set themes = (businesses[variant].themes) if businesses[variant] else [] %}
{% if themes %}
<section class="section section--tint" id="explore" data-module="theme">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Explore the bench</p>
      <h2>{{ themesTitle or "Where to go this fall" }}</h2>
      <p>{{ themesIntro or "Handpicked local spots. Tap any to visit their site." }}</p>
    </div>

    {% for theme in themes %}
    <div class="theme">
      <h3 class="theme__title">{{ theme.title }}</h3>
      <div class="scroller" role="list" aria-label="{{ theme.title }}">
        {% for biz in theme.items %}
        <a class="biz-card" role="listitem" href="{{ biz.url }}"
           data-module="theme" data-card-label="{{ theme.title }} — {{ biz.name }}">
          <div class="biz-card__media">
            <img src="{{ biz.img }}" alt="{{ biz.name }}" width="600" height="450" loading="lazy" decoding="async">
          </div>
          <div class="biz-card__body">
            <p class="biz-card__name">{{ biz.name }}</p>
            <p class="biz-card__blurb">{{ biz.blurb }}</p>
            <p class="biz-card__go">Visit &rarr;</p>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
