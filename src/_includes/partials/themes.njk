{# Themed photo-card scrollers on warm paper, per the client mockup.
   Data-driven from _data/businesses.json; every card is an outbound link. #}
{% set themes = (businesses[variant].themes) if businesses[variant] else [] %}
{% if themes %}
<section class="section section--warm" id="explore" data-module="theme">
  <div class="wrap">
    <div class="section__head"><h2>{{ themesTitle or "Where to go this fall" }}</h2></div>
    {% for theme in themes %}
    <div class="theme">
      <h3>{{ theme.title }}</h3>
      <div class="scroller">
        {% for biz in theme.items %}
        <a class="card" href="{{ biz.url }}" data-module="theme" data-card-label="{{ theme.title }} — {{ biz.name }}">
          <img src="{{ biz.img }}" alt="{{ biz.name }}" width="600" height="400" loading="lazy" decoding="async">
          <h4>{{ biz.name }}</h4>
          <p>{{ biz.blurb }}</p>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
