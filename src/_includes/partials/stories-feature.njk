{# STORIES FEATURE CARD — large visual label linking to the /stories/ hub. #}
<section class="section" id="stories">
  <div class="wrap">
    <div class="feature stamp">
      <img src="/assets/img/photos/stories-hub.jpg" alt="Fall vineyards rolling across the Niagara bench" width="1600" height="1000" loading="lazy" decoding="async">
      <div class="feature__scrim"></div>
      <div class="feature__body">
        <h3>{{ storiesFeatureTitle or "Fall stories from the bench" }}</h3>
        <p>{{ storiesFeatureBlurb or "Guides, local picks and reasons to visit this season." }}</p>
        <p style="margin:.8rem 0 0"><a class="btn btn--gold" href="/stories/" data-module="stories">Read fall stories</a></p>
        <a class="stretched" href="/stories/" aria-label="Read fall stories"></a>
      </div>
    </div>
  </div>
</section>
