{# Ink footer — brand, one line, privacy, social text links. Per the client mockup. #}
<footer class="site-footer">
  <div class="wrap">
    <div>
      <span class="brand">Wander Niagara</span>
      <p>{{ site.campaign }}. A {{ site.name }} campaign. &copy; {{ site.year }}.</p>
      <p><a href="{{ site.privacyUrl }}" data-module="footer">Privacy</a></p>
    </div>
    <div class="foot-links">
      {% for s in site.social %}<a href="{{ s.url }}" data-module="footer" data-card-label="{{ s.label }}">{{ s.label }}</a>
      {% endfor %}
    </div>
  </div>
</footer>
