{# Footer — the crate bottom: roundel, region line, privacy, social. #}
<footer class="site-footer">
  <div class="wrap">
    <div>
      <span class="brand" aria-label="{{ site.name }}">
        <svg class="roundel" style="width:40px;height:40px" aria-hidden="true"><use href="#i-roundel"></use></svg>
        <span class="wordmark">Wander Niagara</span>
      </span>
      <p class="footer-region">Grown &amp; packed in St. Catharines &amp; the Benchlands, Ont.</p>
      <p class="footer-note">{{ site.campaign }}. A {{ site.name }} campaign. &copy; {{ site.year }}.</p>
      <p class="footer-note"><a href="{{ site.privacyUrl }}" data-module="footer">Privacy</a></p>
    </div>
    <div class="social" aria-label="Social media">
      {% for s in site.social %}
      <a href="{{ s.url }}" aria-label="{{ s.label }}" data-module="footer" data-card-label="{{ s.label }}">
        {% if s.icon == 'instagram' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        {% elif s.icon == 'facebook' %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.5l.5-3H14V9z"/></svg>
        {% elif s.icon == 'tiktok' %}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M15 4c.3 2 1.6 3.4 3.5 3.7V10c-1.3 0-2.5-.4-3.5-1v5.5A4.5 4.5 0 1 1 10.5 10v2.4A2.1 2.1 0 1 0 12.6 14.5V4H15z"/></svg>
        {% else %}<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="9"/></svg>{% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</footer>
