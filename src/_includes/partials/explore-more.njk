{# KEEP EXPLORING — 3 business/itinerary cards at the end of an article.
   Uses front-matter `exploreCards` if present; otherwise falls back to the
   couples itineraries so the module is never empty in a demo. #}
{% set cards = exploreCards if exploreCards else itineraries.couples %}
<section class="section section--tint" id="keep-exploring" data-module="stories">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Keep exploring</p>
      <h2>{{ exploreTitle or "Turn this into a trip" }}</h2>
    </div>
    <div class="explore-grid">
      {% for c in cards %}
      <article class="card">
        <div class="card__media">
          <img src="{{ c.img }}" alt="{{ c.title or c.name }}" width="800" height="600" loading="lazy" decoding="async">
        </div>
        <div class="card__body">
          <h3 class="card__title">{{ c.title or c.name }}</h3>
          {% if c.blurb %}<p class="card__blurb">{{ c.blurb }}</p>{% endif %}
          <div class="card__cta">
            <a class="btn btn--small" href="{{ c.url }}" data-module="stories" data-card-label="{{ c.title or c.name }}">{{ c.cta or "View" }}</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
