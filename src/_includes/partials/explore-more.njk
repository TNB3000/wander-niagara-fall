{# KEEP EXPLORING — 3 crate labels at the end of an article. Uses front-matter
   `exploreCards` if present; otherwise the couples itineraries (never empty). #}
{% set cards = exploreCards if exploreCards else itineraries.couples %}
<section class="section section--leaf" id="keep-exploring" data-module="stories">
  <div class="wrap">
    <div class="section__head stamp">
      <h2><span class="rule-l"></span>{{ exploreTitle or "Turn this into a trip" }}</h2>
    </div>
    <div class="explore-grid">
      {% set grounds = ["crate--concord", "crate--persimmon", "crate--leaf"] %}
      {% for c in cards %}
      <article class="crate {{ grounds[loop.index0 % 3] }} stamp">
        <div class="crate__art">
          <svg aria-hidden="true"><use href="#i-{{ c.icon or 'leaf' }}"></use></svg>
        </div>
        <div class="crate__body">
          <h3 class="crate__title">{{ c.title or c.name }}</h3>
          {% if c.blurb %}<p class="crate__blurb">{{ c.blurb }}</p>{% endif %}
          <div class="crate__cta">
            <a class="btn btn--small" href="{{ c.url }}" data-module="stories" data-card-label="{{ c.title or c.name }}">{{ c.cta or "View" }}</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
