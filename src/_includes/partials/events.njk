{# Events — green section with simple date rows, per the client mockup.
   `eventRows` controls count (3 on audience pages; all on /events/). #}
{% set rows = eventRows or 3 %}
<section class="section section--green" id="events" data-module="events">
  <div class="wrap">
    <div class="section__head head-row">
      <h2>{{ eventsTitle or "What's on this fall" }}</h2>
      <a class="tlink" href="{{ eventsSeeAllHref or '/events/' }}" data-module="events" data-card-label="See all fall events">See all fall events</a>
    </div>
    <div class="events">
      {% for ev in events.items %}{% if loop.index0 < rows %}
      <a class="event" href="{{ ev.url }}" data-module="events" data-card-label="{{ ev.title }}">
        <span class="event__date">{{ ev.dateLabel }}</span>
        <span>
          <span class="event__name">{{ ev.title }}</span>
          <span class="event__where">{{ ev.venue }}</span>
        </span>
      </a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
