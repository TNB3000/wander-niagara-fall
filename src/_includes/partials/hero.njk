{# Full-bleed photo hero: one bold headline, one sub, one CTA. #}
<section class="hero" id="hero">
  <div class="hero__media">
    <img src="{{ heroImg or '/assets/img/photos/stories-hub.jpg' }}"
         alt="{{ heroAlt or 'Fall in St. Catharines and the Benchlands' }}"
         width="1600" height="1000" fetchpriority="high" decoding="async">
  </div>
  <div class="wrap hero__inner">
    <h1>{{ headline or "Fall, at your pace." }}</h1>
    <p>{{ sub or "Wine, colour, farms and events across the bench." }}</p>
    <a class="btn" href="{{ heroCtaHref or '#itineraries' }}" data-module="hero">{{ heroCtaLabel or "See fall itineraries" }}</a>
  </div>
</section>
