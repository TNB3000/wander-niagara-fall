<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title %} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Open Graph / social -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.campaign }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if heroPreloadImg %}<meta property="og:image" content="{{ site.url }}{{ heroPreloadImg }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <!-- Preconnect to third-party embed origins (lazy-loaded later) -->
  {% for origin in embeds.preconnect %}<link rel="preconnect" href="{{ origin }}" crossorigin>
  {% endfor %}

  <!-- LCP: preload hero image with high priority -->
  {% if heroPreloadImg %}<link rel="preload" as="image" href="{{ heroPreloadImg }}" fetchpriority="high">{% endif %}

  <!-- Critical CSS inlined; main CSS deferred (non-render-blocking) -->
  <style>{{ "src/assets/css/critical.css" | readFile | safe }}</style>
  <link rel="preload" href="/assets/css/main.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/assets/css/main.css"></noscript>

  <!-- Analytics config slot (read by app.js). IDs come from _data/embeds.js -->
  <script type="application/json" id="wn-config">
  {
    "ga4Id": {{ (embeds.ga4Id or "") | dump | safe }},
    "metaPixelId": {{ (embeds.metaPixelId or "") | dump | safe }},
    "gtmId": {{ (embeds.gtmId or "") | dump | safe }},
    "variant": {{ (variant or "") | dump | safe }},
    "ref": {
      "enabled": {{ "true" if site.outboundRef.enabled else "false" }},
      "param": {{ site.outboundRef.param | dump | safe }},
      "value": {{ site.outboundRef.value | dump | safe }},
      "disabledDomains": {{ site.outboundRef.disabledDomains | dump | safe }}
    }
  }
  </script>

  <!-- Site-wide structured data: Organization + BreadcrumbList (AEO) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/img/logo.svg",
    "sameAs": [{% for s in site.social %}"{{ s.url }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "{{ site.name }}", "item": "{{ site.url }}/" }{% if title %},
      { "@type": "ListItem", "position": 2, "name": "{{ title }}", "item": "{{ site.url }}{{ page.url }}" }{% endif %}
    ]
  }
  </script>
  {% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>
  {% include "partials/footer.njk" %}

  {% if stickyCtaLabel %}
  <div class="sticky-cta" role="region" aria-label="Quick action">
    <a class="btn" href="{{ stickyCtaHref or '#itineraries' }}" data-module="sticky-cta">{{ stickyCtaLabel }}</a>
  </div>
  {% endif %}

  {% include "partials/newsletter-modal.njk" %}

  <script src="/assets/js/app.js" defer></script>
</body>
</html>
