{# ARTICLE TEMPLATE — hero image, readable body (short measure, generous type),
   inline image support, a "keep exploring" module, sticky CTA. #}
{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "image": "{{ site.url }}{{ image or '/assets/img/placeholder-story-1.svg' }}",
  "datePublished": "{{ date or '2026-09-01' }}",
  "author": { "@type": "Organization", "name": "{{ author or site.name }}" },
  "publisher": { "@type": "Organization", "name": "{{ site.name }}", "logo": { "@type": "ImageObject", "url": "{{ site.url }}/assets/img/logo.svg" } },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
{% endblock %}

{% block content %}
  <div class="article-hero">
    <img src="{{ image or '/assets/img/placeholder-story-1.svg' }}" alt="{{ title }}"
         width="1200" height="800" fetchpriority="high" decoding="async">
    <div class="article-hero__scrim"></div>
    <div class="wrap article-hero__inner">
      <p class="kicker" style="color:var(--accent)">{{ site.kicker }}</p>
      <h1>{{ title }}</h1>
    </div>
  </div>

  <article class="section">
    <div class="wrap">
      <p class="article-meta">{{ category or "Fall" }} · {{ readTime or "4 min read" }}{% if author %} · {{ author }}{% endif %}</p>
      <div class="prose">
        {{ content | safe }}
      </div>
      <p class="center mt-2"><a class="section__link" href="/stories/" data-module="stories">&larr; All fall stories</a></p>
    </div>
  </article>

  {% include "partials/explore-more.njk" %}
  {% include "partials/newsletter-inline.njk" %}
{% endblock %}
