{# BLOG POST — hyper simple, per the client: "the headline is just the article
   title, then it's the freaking article, I plug in photos, and then some of the
   little whereabouts pieces embedded in there as well." #}
{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "image": "{{ site.url }}{{ image }}",
  "datePublished": "{{ date or '2026-09-07' }}",
  "author": { "@type": "Organization", "name": "{{ site.name }}" },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
{% endblock %}

{% block content %}
  <div class="wrap article-head">
    <h1>{{ title }}</h1>
    <p class="meta">{{ category or "Fall" }} · {{ readTime or "5 min read" }} · {{ site.name }}</p>
  </div>

  {% if image %}
  <div class="wrap article-hero">
    <img src="{{ image }}" alt="{{ heroAlt or title }}" width="1600" height="1000" fetchpriority="high" decoding="async">
  </div>
  {% endif %}

  <div class="wrap">
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>

  <section class="section" id="widget">
    <div class="wrap">
      {% set slotLabel = widgetLabel or "Whereabouts — related itineraries & listings widget" %}
      {% set slotCells = 4 %}
      {% include "partials/widget-slot.njk" %}
    </div>
  </section>

  {% include "partials/newsletter-inline.njk" %}
{% endblock %}
