{# AUDIENCE PAGE LAYOUT — /families/ and /couples/. Same template, audience
   content. Structure per the client mockup: hero → itineraries → themed photo
   cards → widget zone → events → aligned blog post → getting here → FAQ → newsletter. #}
{% extends "base.njk" %}

{% block content %}
  {% include "partials/hero.njk" %}
  {% include "partials/itineraries.njk" %}
  {% include "partials/themes.njk" %}

  {% if widgetLabel %}
  <section class="section" id="widget" data-module="widget">
    <div class="wrap">
      {% set slotLabel = widgetLabel %}
      {% set slotCells = 8 %}
      {% include "partials/widget-slot.njk" %}
    </div>
  </section>
  {% endif %}

  {% include "partials/events.njk" %}
  {% include "partials/blog-feature.njk" %}
  {% include "partials/getting-here.njk" %}
  {% include "partials/faq.njk" %}
  {% include "partials/newsletter-inline.njk" %}
{% endblock %}
