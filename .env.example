# Copy to .env (gitignored) and fill in. Used only by scripts/deploy-flywheel.sh.
# Flywheel dashboard → site → Advanced → SFTP credentials.
FLYWHEEL_USER=
FLYWHEEL_PASS=
# Remote path to the WordPress root (the folder that contains wp-content),
# e.g. /wanderniagara  — the script deploys into <this>/fall and deletes ONLY inside fall/.
FLYWHEEL_SITE_PATH=
